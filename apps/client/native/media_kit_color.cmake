# Expose the actual renderer selected by media_kit, including an automatic GL
# failure -> SW fallback. Configuration intent is not a capability check.
# Run after the viewport patch, on its generated copy, never the Pub cache.
function(reelnest_patch_media_kit_colors platform)
  get_target_property(color_sources media_kit_video_plugin SOURCES)
  set(color_source "${CMAKE_CURRENT_BINARY_DIR}/reelnest_media_kit/video_output.cc")
  list(FIND color_sources "${color_source}" color_input)
  if(color_input EQUAL -1)
    message(FATAL_ERROR "Color patch requires the project-owned viewport source; refusing to edit the shared Pub cache")
  endif()
  file(READ "${color_source}" color_code)
  if(platform STREQUAL "windows")
    set(color_gl "\n          is_hardware_acceleration_enabled = true;")
    set(color_gl_fixed "${color_gl}\n          mpv_set_property_string(handle_, \"user-data/reelnest/render-api\", \"opengl\");")
    set(color_sw "\n      if (mpv_render_context_create(&render_context_, handle_, params) == 0) {")
    set(color_sw_fixed "${color_sw}\n        mpv_set_property_string(handle_, \"user-data/reelnest/render-api\", \"sw\");")
  elseif(platform STREQUAL "linux")
    set(color_gl "\n                hardware_acceleration_supported = TRUE;")
    set(color_gl_fixed "${color_gl}\n                mpv_set_property_string(self->handle, \"user-data/reelnest/render-api\", \"opengl\");")
    set(color_sw "\n                                    params) == 0) {")
    set(color_sw_fixed "${color_sw}\n        mpv_set_property_string(self->handle, \"user-data/reelnest/render-api\", \"sw\");")
  else()
    message(FATAL_ERROR "Unknown media_kit color patch platform")
  endif()
  foreach(color_kind gl sw)
    string(FIND "${color_code}" "${color_${color_kind}}" color_offset)
    if(color_offset EQUAL -1)
      message(FATAL_ERROR "media_kit_video renderer changed; review the color capability patch")
    endif()
    string(REPLACE "${color_${color_kind}}" "${color_${color_kind}_fixed}" color_code "${color_code}")
  endforeach()
  file(WRITE "${color_source}" "${color_code}")
endfunction()
