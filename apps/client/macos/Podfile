platform :osx, '12.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Flutter 3.47.6's standard macOS CocoaPods setup. Plugins without SwiftPM
# support (including media_kit_video 2.0.1) still use this integration.
def flutter_root
  settings = File.expand_path(File.join('Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __dir__)
  unless File.exist?(settings)
    raise "#{settings} must exist. Run flutter pub get before pod install."
  end
  File.foreach(settings) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT missing in #{settings}. Run flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require_relative 'media_kit_viewport'

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
  ReelNestMediaKitViewport.apply(installer, macos_root: __dir__)
end
