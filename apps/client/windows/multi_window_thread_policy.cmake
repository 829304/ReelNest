# Apply only to our generated build sources, never to the shared Pub cache.
# Locked desktop_multi_window 0.3.1 creates each player engine here.
if(TARGET desktop_multi_window_plugin)
  get_target_property(player_source_dir desktop_multi_window_plugin SOURCE_DIR)
  get_target_property(player_sources desktop_multi_window_plugin SOURCES)
  set(player_window_source "${player_source_dir}/flutter_window.cc")
  file(READ "${player_window_source}" player_window_code)
  if(NOT player_window_code MATCHES "set_ui_thread_policy")
    set(project_line "flutter::DartProject project(L\"data\");")
    string(FIND "${player_window_code}" "${project_line}" project_offset)
    if(project_offset EQUAL -1)
      message(FATAL_ERROR "desktop_multi_window engine construction changed; review thread policy shim")
    endif()
    string(REPLACE "${project_line}"
      "${project_line}\n  project.set_ui_thread_policy(flutter::UIThreadPolicy::RunOnSeparateThread);"
      player_window_code "${player_window_code}")
  endif()
  set(player_generated_dir "${CMAKE_CURRENT_BINARY_DIR}/reelnest_multi_window")
  file(MAKE_DIRECTORY "${player_generated_dir}")
  set(player_generated_source "${player_generated_dir}/flutter_window.cc")
  file(WRITE "${player_generated_source}" "${player_window_code}")
  set(player_fixed_sources "")
  foreach(player_source IN LISTS player_sources)
    if(NOT IS_ABSOLUTE "${player_source}")
      set(player_source "${player_source_dir}/${player_source}")
    endif()
    if(player_source STREQUAL player_window_source)
      list(APPEND player_fixed_sources "${player_generated_source}")
    else()
      list(APPEND player_fixed_sources "${player_source}")
    endif()
  endforeach()
  set_property(TARGET desktop_multi_window_plugin PROPERTY SOURCES "${player_fixed_sources}")
  target_include_directories(desktop_multi_window_plugin PRIVATE "${player_source_dir}")
endif()